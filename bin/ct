#!/usr/bin/env bash
set -euo pipefail

if (( BASH_VERSINFO[0] < 4 )); then
  echo "Error: ct requires bash 4.0 or newer (found $BASH_VERSION)." >&2
  echo "On macOS: brew install bash" >&2
  exit 1
fi

ct_self="$(readlink -f "${BASH_SOURCE[0]}")"
ct_dir="$(cd "$(dirname "$ct_self")" && pwd)"
# shellcheck source=/dev/null
source "$ct_dir/ct-lib.sh"

# Generic defaults. Override in ~/.config/ct/config.sh:
#   CT_ROOTS=("$HOME/dev" "$HOME/work")
CT_ROOTS=("$HOME/dev" "$HOME/src" "$HOME/code" "$HOME/projects")
if [[ -f "$HOME/.config/ct/config.sh" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.config/ct/config.sh"
fi

ct_die() {
  echo "Error: $*" >&2
  exit 1
}

# Create or reuse the tmux session for a task, and start the agent in pane 0.
#
# Every -t target here is prefixed with `=`, which forces an exact session-name
# match. A bare target is resolved by tmux as exact, then fnmatch, then PREFIX,
# so with a live `auth-refactor` and no `auth`, `has-session -t auth` succeeds
# against the wrong session -- and the send-keys below would type the agent
# command into another task's pane. `=` applies to the `session:window.pane`
# form too.
ct_ensure_tmux() {
  local slug="$1" path="$2" existing

  if tmux has-session -t "=$slug" 2>/dev/null; then
    # The trailing colon is required. `display-message -t` takes a target-PANE,
    # and a bare `=slug` with no window part resolves to nothing at all --
    # printing an empty line and exiting 0 rather than failing. `=slug:` means
    # "the current pane of exactly this session". The emptiness guard below is
    # there because that failure mode is silent.
    existing="$(tmux display-message -p -t "=$slug:" '#{session_path}')"
    [[ -n "$existing" ]] || ct_die "tmux session '$slug' exists but reported no path"
    # Compared with -ef (device+inode) rather than a string match, for the same
    # reason ct_add_worktree does it: git canonicalizes worktree paths when it
    # registers them (/var -> /private/var on macOS) while tmux stores whatever
    # it was handed, so `ct switch` -- which re-derives the path from
    # `git worktree list` -- would otherwise report a mismatch between two
    # spellings of one directory.
    if ! [[ "$existing" -ef "$path" ]]; then
      ct_die "tmux session '$slug' already exists at $existing, not $path"
    fi
    echo "Reusing tmux session $slug"
    return 0
  fi

  tms --no-attach --no-project "$path"
  tmux send-keys -t "=$slug:main.0" "$(ct_claude_cmd "$path")" C-m
  echo "Created tmux session $slug"
}

# Focus the task's cmux workspace, creating it if absent.
ct_ensure_workspace() {
  local slug="$1" path="$2" description="$3" focus="$4" ref window

  ref="$(cmux tree --all --json 2>/dev/null \
    | ct_parse_cmux \
    | awk -F'\t' -v s="$slug" '$2 == s { print $1; exit }')" || true

  # Guarded for the same reason as `workspace create` below: by this point the
  # worktree and tmux session already exist, so a cmux hiccup should degrade
  # rather than abort. This is the common path once tasks exist, so leaving it
  # unguarded would make cmux the single point of failure for `ct new`.
  if [[ -n "$ref" ]]; then
    if ! cmux workspace select "$ref"; then
      echo "Warning: could not select cmux workspace $ref." >&2
      # The `=` forces an exact tmux match (see ct_ensure_tmux). It is single
      # quoted because this line is meant to be pasted into a shell, and a bare
      # leading `=` is an equals-expansion in zsh -- `tmux attach -t =foo`
      # fails with "foo not found" before tmux ever runs.
      echo "Attach by hand with: tmux attach -t '=$slug'" >&2
      return 0
    fi
    echo "Selected existing cmux workspace $ref"
    return 0
  fi

  # The git and tmux work is already done by this point, so a cmux failure
  # is reported rather than fatal.
  if ! window="$(cmux current-window 2>/dev/null)" || [[ -z "$window" ]]; then
    echo "Warning: cmux is not reachable; worktree and tmux session are ready." >&2
    echo "Attach by hand with: tmux attach -t '=$slug'" >&2
    return 0
  fi

  if ! cmux workspace create \
    --window "$window" \
    --cwd "$path" \
    --name "$slug" \
    --description "$description" \
    --command "tmux attach -t '=$slug'" \
    --focus "$focus"; then
    echo "Warning: cmux workspace create failed; attach by hand: tmux attach -t '=$slug'" >&2
    return 0
  fi

  echo "Created cmux workspace $slug"
}

# Gather every task across every discovered repo.
ct_tasks() {
  local repo wt_tmp tmux_tmp cmux_tmp
  wt_tmp="$(mktemp)"
  tmux_tmp="$(mktemp)"
  cmux_tmp="$(mktemp)"
  trap 'rm -f "$wt_tmp" "$tmux_tmp" "$cmux_tmp"' RETURN

  while IFS= read -r repo; do
    git -C "$repo" worktree prune 2>/dev/null || true
    # `|| true` for the same reason as the tmux and cmux lines below: git exits
    # 128 on anything that is not a real repository, and ct_discover_repos will
    # happily find a bare directory named `.git`. Without the guard, pipefail
    # propagates that and one bad directory silently empties the whole listing.
    git -C "$repo" worktree list --porcelain 2>/dev/null \
      | ct_parse_worktrees >> "$wt_tmp" || true
  done < <(ct_discover_repos "${CT_ROOTS[@]}")

  tmux ls -F '#{session_name}:#{session_path}' 2>/dev/null | ct_parse_tmux > "$tmux_tmp" || true
  cmux tree --all --json 2>/dev/null | ct_parse_cmux > "$cmux_tmp" || true

  ct_join_task_state "$wt_tmp" "$tmux_tmp" "$cmux_tmp" | sort
}

ct_cmd_list() {
  if [[ "${1:-}" == "--json" ]]; then
    ct_tasks | jq -R -s -c 'split("\n") | map(select(length > 0) | split("\t")
      | {slug: .[0], repo: .[1], branch: .[2], live: .[3]})'
    return 0
  fi

  printf '%-40s %-24s %-34s %s\n' SLUG REPO BRANCH LIVE
  ct_tasks | while IFS=$'\t' read -r slug repo branch live; do
    printf '%-40s %-24s %-34s %s\n' "$slug" "$(basename "$repo")" "$branch" "$live"
  done
}

ct_pick_repo() {
  ct_discover_repos "${CT_ROOTS[@]}" \
    | ct_order_by_recent \
    | fzf --prompt='repo> ' --height=40% --reverse
}

ct_pick_name() {
  local issues row name

  # Linear is optional. Any failure falls through to free text.
  issues="$(ct-linear 2>/dev/null)" || issues=""

  if [[ -n "$issues" ]]; then
    row="$(printf '%s\n' "$issues" \
      | fzf --prompt='linear (esc to type a name)> ' --height=40% --reverse --delimiter='\t')" || row=""
    if [[ -n "$row" ]]; then
      printf '%s %s\n' "$(printf '%s' "$row" | cut -f1)" "$(printf '%s' "$row" | cut -f2)"
      return 0
    fi
  fi

  read -r -p "Task name: " name
  printf '%s\n' "$name"
}

ct_cmd_new() {
  local repo="" name="" focus="true" description=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)     [[ $# -ge 2 ]] || ct_die "--repo needs a value"; repo="$2"; shift 2 ;;
      --name)     [[ $# -ge 2 ]] || ct_die "--name needs a value"; name="$2"; shift 2 ;;
      --no-focus) focus="false"; shift ;;
      *)          ct_die "unknown flag '$1'" ;;
    esac
  done

  # The trailing `|| true` is load-bearing. fzf exits non-zero when cancelled,
  # and a failing command substitution in an assignment aborts under `set -e`
  # even on the right-hand side of `||` — bash exempts every command in an
  # `&&`/`||` list except the one following the final operator. Without it,
  # cancelling the picker kills ct before it reaches the guard below, so the
  # user gets a silent exit instead of "no repo selected".
  [[ -n "$repo" ]] || repo="$(ct_pick_repo)" || true
  [[ -n "$repo" ]] || ct_die "no repo selected"
  [[ -n "$name" ]] || name="$(ct_pick_name)" || true
  [[ -n "$name" ]] || ct_die "no name given"

  repo="${repo%/}"
  [[ -d "$repo/.git" ]] || ct_die "$repo is not a git repository"

  # ct_worktree_root degrades to a CWD-relative path on relative input
  # (`myrepo` -> `./myrepo-wt`), which would put the worktree inside the repo
  # once `git -C` resolved it. Normalize before any path derivation.
  repo="$(cd "$repo" && pwd)"

  local slug path
  slug="$(ct_slugify "$name")"
  [[ -n "$slug" ]] || ct_die "'$name' slugified to an empty string"
  path="$(ct_worktree_path "$repo" "$slug")"
  description="$name"

  ct_add_worktree "$repo" "$slug"
  ct_recent_add "$repo"
  ct_ensure_tmux "$slug" "$path"
  ct_ensure_workspace "$slug" "$path" "$description" "$focus"

  echo "Task $slug ready at $path"
}

ct_cmd_switch() {
  local slug="${1:-}" row repo path

  if [[ -z "$slug" ]]; then
    # `|| true` because fzf exits non-zero when cancelled and a failing command
    # substitution in an assignment aborts under `set -e`, which would kill ct
    # before it reached the guard below.
    row="$(ct_tasks | fzf --prompt='task> ' --height=40% --reverse --delimiter='\t')" || true
    [[ -n "$row" ]] || ct_die "no task selected"
    slug="$(printf '%s' "$row" | cut -f1)"
    repo="$(printf '%s' "$row" | cut -f2)"
  else
    row="$(ct_tasks | awk -F'\t' -v s="$slug" '$1 == s { print; exit }')"
    [[ -n "$row" ]] || ct_die "no task named '$slug'"
    repo="$(printf '%s' "$row" | cut -f2)"
  fi

  path="$(ct_worktree_path "$repo" "$slug")"
  [[ -d "$path" ]] || ct_die "worktree missing at $path"

  ct_recent_add "$repo"
  ct_ensure_tmux "$slug" "$path"
  ct_ensure_workspace "$slug" "$path" "$slug" "true"
}

ct_cmd_finish() {
  local slug="" force=0 row repo path ws_ref

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      -*)      ct_die "unknown flag '$1'" ;;
      *)       [[ -z "$slug" ]] || ct_die "unexpected extra argument '$1'"
               slug="$1"; shift ;;
    esac
  done

  if [[ -z "$slug" ]]; then
    # `|| true` because fzf exits non-zero when cancelled and a failing command
    # substitution in an assignment aborts under `set -e`, which would kill ct
    # before it reached the guard below.
    row="$(ct_tasks | fzf --prompt='finish> ' --height=40% --reverse --delimiter='\t')" || true
    [[ -n "$row" ]] || ct_die "no task selected"
    slug="$(printf '%s' "$row" | cut -f1)"
    repo="$(printf '%s' "$row" | cut -f2)"
  else
    row="$(ct_tasks | awk -F'\t' -v s="$slug" '$1 == s { print; exit }')"
    [[ -n "$row" ]] || ct_die "no task named '$slug'"
    repo="$(printf '%s' "$row" | cut -f2)"
  fi

  path="$(ct_worktree_path "$repo" "$slug")"

  if ! ct_worktree_clean "$path"; then
    if [[ "$force" -eq 0 ]]; then
      ct_die "$slug has unsaved work (rerun with --force to remove anyway)"
    fi
    echo "Removing anyway (--force)"
  fi

  ws_ref="$(cmux tree --all --json 2>/dev/null \
    | ct_parse_cmux \
    | awk -F'\t' -v s="$slug" '$2 == s { print $1; exit }')" || true

  # Remove the worktree FIRST, before touching tmux or cmux. It is the step
  # most likely to fail legitimately — a dirty tree, or something writing to
  # the worktree between the check above and here — and failing it after the
  # teardown would leave the user with no session, no workspace, and the
  # worktree still on disk. Doing it first means a failure costs nothing that
  # was not already there, and they can retry.
  #
  # --force is forwarded because `git worktree remove` refuses a dirty worktree
  # on its own, independently of ct_worktree_clean above. Without forwarding it,
  # `ct finish --force` prints "Removing anyway" and then fails to remove
  # anything — the exact half-state --force exists to avoid. This only ever
  # deletes the working directory and its registration, never a branch.
  if [[ "$force" -eq 1 ]]; then
    git -C "$repo" worktree remove --force "$path"
  else
    git -C "$repo" worktree remove "$path"
  fi
  git -C "$repo" worktree prune

  # Guarded so a cmux failure cannot abort what remains of the teardown.
  if [[ -n "$ws_ref" ]]; then
    if cmux workspace close "$ws_ref"; then
      echo "Closed cmux workspace $ws_ref"
    else
      echo "Warning: could not close cmux workspace $ws_ref; continuing." >&2
    fi
  fi

  # `=` is not optional here. Without it, tmux falls back to a prefix match, so
  # finishing `auth` after its own session is gone finds and destroys a live
  # `auth-refactor` -- while printing "Killed tmux session auth".
  if tmux has-session -t "=$slug" 2>/dev/null; then
    tmux kill-session -t "=$slug"
    echo "Killed tmux session $slug"
  fi

  echo "Removed worktree $path (branch $slug kept)"
}

ct_usage() {
  cat <<'USAGE'
Usage:
  ct new    [--repo <path>] [--name <text>] [--no-focus]
  ct switch [<slug>]
  ct finish [<slug>] [--force]
  ct list   [--json]
USAGE
}

main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift

  case "$cmd" in
    new)          ct_cmd_new "$@" ;;
    switch)       ct_cmd_switch "$@" ;;
    finish)       ct_cmd_finish "$@" ;;
    list)         ct_cmd_list "$@" ;;
    -h|--help|"") ct_usage ;;
    *)            ct_die "unknown command '$cmd'" ;;
  esac
}

main "$@"
