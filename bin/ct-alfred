#!/usr/bin/env bash
#
# ct-alfred - Alfred Script Filter adapter for ct.
#
# Alfred runs workflow scripts with a bare PATH and with /bin/bash, which is
# 3.2 on macOS. Everything above the re-exec below must therefore be free of
# bash 4 syntax. ct-lib.sh uses mapfile and `local -A`, so it cannot be
# sourced until after the re-exec.

# Alfred's PATH carries none of these. Append rather than prepend: the bats
# suite puts stub binaries at the front of PATH, and prepending here would
# silently defeat them and run the tests against the live system.
PATH="$PATH:$HOME/.local/bin:$HOME/bin:/opt/homebrew/bin:/usr/local/bin"
PATH="$PATH:/Applications/cmux.app/Contents/Resources/bin"
export PATH

# bash is the exception to the append rule: /bin/bash is 3.2 and would always
# win, so look for a modern one by explicit path.
ct_alfred_find_bash() {
  local candidate
  for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash "$(command -v bash)"; do
    [ -n "$candidate" ] || continue
    [ -x "$candidate" ] || continue
    if "$candidate" -c '[ "${BASH_VERSINFO[0]}" -ge 4 ]' 2>/dev/null; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] && [ -z "${CT_ALFRED_REEXEC:-}" ]; then
  ct_alfred_bash="$(ct_alfred_find_bash)" || {
    # No JSON here: without bash 4 nothing below can run, and Alfred shows an
    # empty list either way. stderr reaches Alfred's debug console.
    echo "ct-alfred requires bash 4+. On macOS: brew install bash" >&2
    exit 1
  }
  # Prepend, not append: `ct` and `tms` use `#!/usr/bin/env bash`, and env takes
  # the FIRST bash on PATH -- /bin/bash 3.2 under Alfred, which ct refuses.
  PATH="$(dirname "$ct_alfred_bash"):$PATH"
  export PATH
  CT_ALFRED_REEXEC=1 exec "$ct_alfred_bash" "$0" "$@"
fi

set -euo pipefail

ct_alfred_self="$(readlink -f "${BASH_SOURCE[0]}")"
ct_alfred_dir="$(cd "$(dirname "$ct_alfred_self")" && pwd)"
# shellcheck source=/dev/null
source "$ct_alfred_dir/ct-lib.sh"
ct_load_config

# One non-actionable row. Every list subcommand must print valid JSON on every
# path -- Alfred renders nothing at all for malformed output, so a bare error
# message would look like "no results" and hide the cause.
ct_alfred_error() {
  jq -nc --arg t "$1" --arg s "$2" \
    '{items: [{title: $t, subtitle: $s, valid: false}]}'
}

ct_alfred_switch_list() {
  local tasks

  # `|| tasks=""` rather than letting set -e kill us: a ct failure must still
  # produce a row, or Alfred shows an empty list with no explanation.
  tasks="$(ct list --json 2>/dev/null)" || tasks=""

  if [[ -z "$tasks" ]]; then
    ct_alfred_error "ct is not available" "Check that ct runs from a terminal"
    return 0
  fi

  printf '%s' "$tasks" | jq -c '
    if length == 0 then
      {items: [{
        title: "No tasks yet",
        subtitle: "Use the ctn keyword to create one",
        valid: false
      }]}
    else
      {items: [ .[] | {
        uid: .slug,
        title: .slug,
        subtitle: ((.repo | split("/") | last) + "  ·  " + .branch
                   + "  ·  " + .live + "      ⏎ switch    ⌘⏎ finish"),
        arg: .slug,
        valid: true,
        mods: {cmd: {
          arg: .slug,
          subtitle: ("Finish " + .slug + " — remove the worktree and kill the session")
        }}
      }]}
    end
  ' 2>/dev/null || ct_alfred_error "ct returned unreadable output" "Run: ct list --json"
}

# Repo rows, most-recently-used first, filtered by a substring of the basename.
ct_alfred_repo_rows() {
  local filter="$1" repo name
  local -a rows=()

  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    name="$(ct_repo_name "$repo")"
    if [[ -n "$filter" && "$name" != *"$filter"* ]]; then
      continue
    fi
    # Built one row at a time through jq so a path with a quote or a backslash
    # cannot break the document.
    rows+=("$(jq -nc --arg n "$name" --arg p "$repo" \
      '{uid: $p, title: $n, subtitle: $p, valid: false,
        autocomplete: ($n + " > ")}')")
  done < <(ct_discover_repos "${CT_ROOTS[@]}" | ct_order_by_recent)

  if [[ "${#rows[@]}" -eq 0 ]]; then
    ct_alfred_error "No repo matches '$filter'" "Check CT_ROOTS in ~/.config/ct/config.sh"
    return 0
  fi

  printf '%s\n' "${rows[@]}" | jq -s -c '{items: .}'
}

ct_alfred_new_list() {
  local query="${1:-}" repo_part name_part repo_path slug note

  if [[ "$query" != *">"* ]]; then
    # Leading and trailing whitespace only; the basename never has any.
    ct_alfred_repo_rows "$(printf '%s' "$query" | sed -E 's/^ +//; s/ +$//')"
    return 0
  fi

  repo_part="$(printf '%s' "${query%%>*}" | sed -E 's/^ +//; s/ +$//')"
  name_part="$(printf '%s' "${query#*>}" | sed -E 's/^ +//; s/ +$//')"

  repo_path=""
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    if [[ "$(ct_repo_name "$candidate")" == "$repo_part" ]]; then
      repo_path="$candidate"
      break
    fi
  done < <(ct_discover_repos "${CT_ROOTS[@]}")

  if [[ -z "$repo_path" ]]; then
    ct_alfred_error "No repo named '$repo_part'" "Delete back past the > to pick one"
    return 0
  fi

  slug="$(ct_slugify "$name_part")"
  if [[ -z "$slug" ]]; then
    ct_alfred_error "Type a task name" "It becomes the branch, worktree, and tmux session"
    return 0
  fi

  # Only mention normalization when it actually changed something, so the
  # subtitle stays quiet on the common path. linear-list's prefill always adds
  # a trailing hyphen to invite a suffix, and ct_slugify always strips it --
  # that alone isn't a normalization the user needs to hear about.
  note="in $repo_part  ·  branch $slug"
  if [[ "$slug" != "${name_part%-}" ]]; then
    note="$note  ·  normalized from what you typed"
  fi

  jq -nc --arg t "Create $slug" --arg s "$note" \
        --arg a "$(printf '%s\t%s' "$repo_path" "$slug")" \
    '{items: [{uid: "create", title: $t, subtitle: $s, arg: $a, valid: true}]}'
}

ct_alfred_linear_list() {
  local issues recent_repo prefix ident title
  local -a rows=()

  issues="$(ct-linear 2>/dev/null)" || issues=""

  if [[ -z "$issues" ]]; then
    ct_alfred_error "No Linear issues" \
      "Assign yourself an issue, or add a key: security add-generic-password -s linear-api -a \"\$USER\" -w"
    return 0
  fi

  # ct-linear returns updatedAt order, which interleaves teams. Alfred shows
  # this list in full before any query is typed, so grouping by team reads
  # better there than recency does.
  #
  # `-t-` splits on the identifier's hyphen: field 1 is the team key, field 2
  # starts with the issue number. `-k2,2n` must be numeric -- a lexical sort
  # puts ABC-100 ahead of ABC-9. The title lands in field 3 and beyond and is
  # never keyed on, so a hyphen inside a title cannot disturb the order.
  # LC_ALL=C keeps the team ordering stable regardless of the caller's locale.
  issues="$(LC_ALL=C sort -t- -k1,1 -k2,2n <<< "$issues")"

  # The repo half of the prefilled query. The MRU file's first line is the
  # most recent repo; ct_recent_add keeps it in that order.
  prefix=""
  recent_repo="$(head -n 1 "$(ct_recent_file)" 2>/dev/null)" || recent_repo=""
  if [[ -n "$recent_repo" ]]; then
    prefix="$(ct_repo_name "$recent_repo") > "
  fi

  while IFS=$'\t' read -r ident title; do
    [[ -n "$ident" ]] || continue
    rows+=("$(jq -nc --arg i "$ident" --arg t "$title" \
      --arg a "${prefix}$(ct_slugify "$ident")-" \
      '{uid: $i, title: $i, subtitle: $t, arg: $a, valid: true}')")
  done <<< "$issues"

  printf '%s\n' "${rows[@]}" | jq -s -c '{items: .}'
}

# Run ct and print whatever it said, merging stderr: ct writes its warnings
# and refusals there, and those are exactly what the notification should show.
# Always exit 0 -- a non-zero exit makes Alfred show a generic failure banner
# instead of the reason ct gave.
ct_alfred_run() {
  local out
  out="$(ct "$@" 2>&1)" || true
  [[ -n "$out" ]] || out="ct $1 finished with no output"
  printf '%s\n' "$out"
  return 0
}

ct_alfred_do_switch() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || { echo "No task slug came through from Alfred"; return 0; }
  ct_alfred_run switch "$slug"
}

ct_alfred_do_finish() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || { echo "No task slug came through from Alfred"; return 0; }
  ct_alfred_run finish "$slug"
}

ct_alfred_do_new() {
  local arg="${1:-}" repo slug

  if [[ "$arg" != *$'\t'* ]]; then
    echo "Could not read the repo and name from Alfred"
    return 0
  fi

  repo="${arg%%$'\t'*}"
  slug="${arg#*$'\t'}"
  ct_alfred_run new --repo "$repo" --name "$slug"
}

case "${1:-}" in
  switch-list) shift; ct_alfred_switch_list "$@" ;;
  new-list)    shift; ct_alfred_new_list "$@" ;;
  linear-list) shift; ct_alfred_linear_list "$@" ;;
  do-switch)   shift; ct_alfred_do_switch "$@" ;;
  do-finish)   shift; ct_alfred_do_finish "$@" ;;
  do-new)      shift; ct_alfred_do_new "$@" ;;
  *)
    echo "Usage: ct-alfred {switch-list|new-list|linear-list|do-switch|do-finish|do-new}" >&2
    exit 2
    ;;
esac
